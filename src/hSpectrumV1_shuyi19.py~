import numpy as np
import matplotlib.pyplot as plt

#%% EXPERIMENT DATA
data = [656.460, 486.271, 434.1692, 410.2892, 397.1198, 389, 383.6485] #wavelength 
nist = np.array(data)
n = len(nist)

#%% MODEL SETUP
#
#rydberg = 1.0973732e7 # 1/m


#formula
m_e = 9.1093837e-31 # kg
e = 1.6021766e-19 #searched by the name elementary charge, C
e_0 = 8.8541878e-12 #searched by the name vacuum electric permittivity, F/m
h = 6.6260702e-34 # J/hz, equavalent to J/s
c = 299792460 # m/s

R = (m_e * e**4) / (8 * e_0**2 * h**3 *c)
print("Rydberg constant:", R, " 1/m")
#%% SIMULATION DATA
#
nf = input("Final state (nf): ")
nf = int(nf)
ni = np.arange(nf + 1, nf + n + 1)

y = 1/(R*(1/nf**2 - 1/ni**2))
y = y * 10**9
plt.plot(ni, nist, 'bx', label = 'NIST sata')
plt.plot(ni, y, 'r.', label = 'Bohr model')

plt.legend()

plt.xlabel("Initial state (ni)")
plt.ylabel("Wavelength (nm)")
plt.title("Hydrogen Emission Spectrum")

plt.grid(True)
plt.show()
